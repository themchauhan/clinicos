# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Supabase (public — safe for the browser bundle) ---
# From `supabase status` for local dev, or Project Settings > API for a
# hosted project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — NEVER expose to the client bundle) ---
# Used only in the one server-only module for platform-admin
# provisioning tasks. Do not import this in any file reachable from
# client components. See CLAUDE.md, hard rule #4.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
# Base URL the app is served from, used for building absolute links
# (e.g. in server-rendered slips). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. File-storage allowance of your Supabase plan, in MB (e.g. 1024
# on Free, 102400 on Pro). Shows a usage percentage and a warning at 80% in
# the platform admin console. Server-only.
# STORAGE_QUOTA_MB=1024
